# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  AgentMon — sozlamalar fayli                                                  ║
# ║                                                                              ║
# ║  Foydalanish:  cp .env.example .env   →   .env ni tahrirlang   →   chmod 600 .env
# ║  Keyin:        docker compose up -d --build                                  ║
# ║                                                                              ║
# ║  Har bir qiymat ustida: NIMA ekani, QAYERDAN olinadi, NAMUNA.                 ║
# ║  Namunaviy qiymatlar (corp.local, dc01, parollar...) — sizniki bilan         ║
# ║  almashtirilishi SHART. IP manzillar — siz bergan haqiqiy qiymatlar.          ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
#
# YOZISH QOIDALARI (muhim!):
#   1. Format:  NOM=qiymat      — "=" atrofida bo'sh joy QO'YMANG.
#   2. Parolda  $  belgisi bo'lsa, qiymatni BITTA tirnoqqa oling:  AD_PASSWORD='Pa$$w0rd!'
#      Aks holda  $  dan keyingi qism yo'qolib, parol noto'g'ri bo'ladi.
#   3. \ (backslash), bo'sh joy, vergul — tirnoqsiz ham to'g'ri o'qiladi.
#   4. # bilan boshlangan qatorlar — izoh, hisobga olinmaydi.
#   5. Keraksiz qatorni o'chirmang — bo'sh qoldiring:  CORTEX_FQDN=
#      (bo'sh manba shunchaki ulanmaydi, tizim qolganlari bilan ishlayveradi).


# ═══════════════════════════════════════════════════════════════════════════════
# 1. INFRATUZILMA
# ═══════════════════════════════════════════════════════════════════════════════

# PostgreSQL bazasining paroli. Tizim ichida ishlatiladi, hech kim qo'lda kiritmaydi.
# FAQAT harf va raqam (u URL ichiga qo'yiladi). Yaratish:  openssl rand -hex 24
# ⚠ Birinchi ishga tushirishdan keyin o'zgartirmang (baza eski parol bilan yaratilgan bo'ladi).
POSTGRES_PASSWORD=

# Redis ichidagi navbat nomi. O'zgartirish shart emas.
REDIS_KEY=nsel

# Redis buferi: engine to'xtab qolganda (yangilash, restart) NetFlow hodisalari shu yerda kutadi.
# O'lchangan: 1 hodisa ~105 bayt → 1 GB ≈ 10 mln hodisa ≈ 10 ming/s da 17 daqiqa, 20 ming/s da 9 daqiqa.
# Bufer to'lsa yangi hodisalar YO'QOLADI. RAM 16 GB server uchun tavsiya: 4gb (~70 / ~35 daqiqa).
# Bandlik: web → Tizim holati → "Redis bufer".
REDIS_MAXMEMORY=4gb

# FTD NetFlow (NSEL) yuboradigan UDP port. FTD'dagi "flow-export destination ... 2055" bilan bir xil bo'lsin.
NSEL_PORT=2055

# NetFlow yuborishga RUXSAT etilgan FTD'lar (eksporterlar) IP'lari, vergul bilan. MAJBURIY (real muhitda).
# Bu — FTD'ning "flow-export destination <interfeys> <agentmon-ip> 2055" dagi interfeys IP'si (paket shu manzildan keladi).
# Bo'sh bo'lsa istalgan qurilma soxta NetFlow yuborib, agenti yo'q kompyuterni "ishlayapti" qilib ko'rsata oladi.
# Tekshirish: sudo tcpdump -ni any udp port 2055 -c 5   (manba IP'larini ko'rasiz)
NSEL_EXPORTERS=

# Web interfeys — faqat HTTPS. Brauzerda: https://<server-ip>:8443
# HTTP porti (WEB_PORT) faqat HTTPS'ga yo'naltiradi — AD parollari hech qachon ochiq kanalda yuborilmaydi.
# Portlar band bo'lmasligi kerak (tekshirish: ss -ltn | grep -E '8443|8088').
WEB_HTTPS_PORT=8443
WEB_PORT=8088
# Qaysi server interfeysida tinglash (0.0.0.0 = hammasi). Oldida boshqa reverse-proxy bo'lsa: 127.0.0.1
WEB_BIND=0.0.0.0
# Web'ga faqat shu tarmoqlardan kirish (IT/SOC xodimlari subnetlari), vergul bilan. Bo'sh = cheklanmagan.
# Qo'llanadi: sudo ./deploy/docker-firewall.sh  (ufw Docker portlarini YOPMAYDI — docs 1.4 ga qarang)
WEB_ALLOWED_NETS=

# Sertifikat: korporativ CA'dan olingan sertifikatni  ./certs/tls.crt  va kalitni  ./certs/tls.key  ga qo'ying.
# Qo'yilmasa — birinchi ishga tushishda o'z-o'zidan imzolangan sertifikat yaratiladi (brauzer ogohlantiradi).
# O'z-o'zidan imzolangan sertifikat uchun nom (brauzerda ochiladigan manzil bilan bir xil bo'lsin):
WEB_TLS_CN=agentmon.corp.local
# Qo'shimcha nomlar/IP'lar:  DNS:agentmon.corp.local,IP:172.25.50.10
WEB_TLS_SAN=

# Logstash xotirasi. Serverda RAM 8 GB va undan ko'p bo'lsa: -Xms2g -Xmx2g
# RAM kam bo'lsa (4–8 GB): -Xms1g -Xmx1g
LS_JAVA_OPTS=-Xms2g -Xmx2g

# NetFlow dekoder oqimlari soni = server CPU yadrolari soni (o'lchangan sig'im, yo'qotishsiz):
#   4 worker ≈ 10–11 ming yozuv/s,   8 worker ≈ 22 ming yozuv/s.
# 4000 kompyuter uchun kutilgan oqim 5–20 ming/s — 8 vCPU server va NSEL_WORKERS=8 tavsiya etiladi.
NSEL_WORKERS=8


# ═══════════════════════════════════════════════════════════════════════════════
# 1a. QAYSI MAHSULOTLAR TEKSHIRILADI
# ═══════════════════════════════════════════════════════════════════════════════

# Vergul bilan: ad, cortex, ksc, si.  Ro'yxatda yo'q mahsulot interfeysda ko'rinmaydi va hisobga kirmaydi.
#
# AD'SIZ REJIM (AD hali ulanmagan bo'lsa):  PRODUCTS_ENABLED=cortex,ksc,si
#   Bunda:
#   - 5-bo'lim (ACTIVE DIRECTORY) qiymatlarini BO'SH qoldiring;
#   - USER_SUBNETS ni ALBATTA to'ldiring (subnetlar AD'dan olinmaydi);
#   - kompyuterlar ro'yxati Cortex va Kaspersky konsollaridan olinadi.
#     Ikkala agenti ham yo'q kompyuter "Noma'lum qurilmalar"da ko'rinadi;
#   - web'ga faqat WEB_ADMIN_USER bilan kiriladi (8-bo'lim);
#   - DC_IPS ni qo'lda yozsangiz, "Noma'lum qurilmalar"da "domen trafigi bor/yo'q" ko'rsatkichi ishlaydi.
PRODUCTS_ENABLED=ad,cortex,ksc,si


# ═══════════════════════════════════════════════════════════════════════════════
# 2. SIGNAL MANZILLARI — agentlar murojaat qiladigan serverlar
#    Format: IP:PORT, bir nechtasi bo'lsa vergul bilan:  1.2.3.4:80,1.2.3.4:443
# ═══════════════════════════════════════════════════════════════════════════════

# Cortex XDR — Broker VM manzili va Agent Proxy porti (siz bergan qiymat).
# Tekshirish: Cortex konsol → Settings → Configurations → Broker VMs → Agent Proxy porti.
TARGET_CORTEX=172.25.44.50:8888

# Kaspersky Security Center — Network Agent ulanadigan portlar.
# 13000 = TLS ulanish (asosiy), 14000 = shifrlanmagan (eski agentlar). Odatda ikkalasi ham qoladi.
TARGET_KSC=172.25.25.111:13000,172.25.25.111:14000

# SearchInform — agentlar ma'lumot yuboradigan server va port (siz bergan qiymat).
TARGET_SI=172.25.43.205:8090

# Domain Controller IP'lari AD'dan AVTOMATIK olinadi — odatda bo'sh qoldiring.
# AD'siz rejimda (yoki qo'shimcha DC bo'lsa) qo'lda yozing:  172.25.10.10,172.25.10.11
DC_IPS=

# DC'ga qaysi portlar domen a'zoligini isbotlaydi: 88=Kerberos, 389=LDAP, 445=SMB (GPO).
# O'zgartirmang. (53/DNS ataylab yo'q — domenga kirmagan qurilmalar ham DNS so'raydi.)
DC_PORTS=88,389,445


# ═══════════════════════════════════════════════════════════════════════════════
# 3. TARMOQLAR — qaysi IP'lar "foydalanuvchi kompyuterlari" hisoblanadi
# ═══════════════════════════════════════════════════════════════════════════════

# Foydalanuvchi (xodimlar kompyuterlari) subnetlari va ularning sayt nomi.
# AD "Sites and Services"da subnetlar kiritilgan bo'lsa — AVTOMATIK olinadi, bo'sh qoldiring.
# ⚠ AD'siz rejimda MAJBURIY — aks holda barcha xususiy IP'lar (serverlar ham) hisobga olinadi.
# Kiritilmagan bo'lsa yoki aniqlashtirmoqchi bo'lsangiz — shu formatda:
#   SUBNET/PREFIKS=Sayt nomi, vergul bilan ajratib
# Namuna (o'zingiznikiga almashtiring):
USER_SUBNETS=10.10.0.0/16=Markaz,10.20.0.0/16=Filial-Samarqand,10.30.0.0/16=Filial-Buxoro

# Hisobga OLINMAYDIGAN tarmoqlar: server VLAN'lari, printerlar, IP-telefonlar, kameralar, Wi-Fi mehmon.
# Ular foydalanuvchi subnetining ichida bo'lsa ham chiqarib tashlanadi.
# Namuna:
EXCLUDE_SUBNETS=10.10.250.0/24,10.10.251.0/24

# Alohida IP'larni chiqarib tashlash (masalan, bitta printer yoki terminal server). Vergul bilan.
EXCLUDE_IPS=


# ═══════════════════════════════════════════════════════════════════════════════
# 4. CHEGARALAR (soniyalarda) — pilotdan keyin moslanadi, boshida o'zgartirmang
# ═══════════════════════════════════════════════════════════════════════════════

# Shu vaqt ichida kompyuterdan HAR QANDAY trafik bo'lsa — u "tirik" (600 = 10 daqiqa).
ALIVE_WINDOW=600
# Kompyuter yoqilgandan keyin salbiy xulosa ("o'rnatilmagan") chiqarishdan oldin kutish (1800 = 30 daq).
GRACE=1800
# Agent shuncha vaqt serverga murojaat qilmasa — "ishlamayapti" deb hisoblanadi:
#   AD: 14400 = 4 soat (GPO yangilanishi ~90 daqiqada bir, zaxira bilan)
THRESH_AD=14400
#   Cortex: 1800 = 30 daqiqa
THRESH_CORTEX=1800
#   Kaspersky: 2700 = 45 daqiqa (Network Agent sinxronizatsiyasi ~15 daqiqada bir)
THRESH_KSC=2700
#   SearchInform: 3600 = 1 soat (pilotda o'lchab aniqlang)
THRESH_SI=3600
# Kaspersky antivirus bazalari shu soatdan eski bo'lsa — "himoya to'liq emas" (72 = 3 kun).
KSC_BASES_MAX_AGE_HOURS=72
# Oldin ishlab turgan agentlarning shuncha ulushi birdan jim bo'lsa (0.2 = 20%) — bu server muammosi
# (masalan, Broker VM tushgan). Tizim yuzlab alert o'rniga bitta insident chiqaradi.
MASS_OUTAGE_RATIO=0.2
# ...lekin kamida shuncha kompyuter bo'lsa.
MASS_OUTAGE_MIN=20
# Ommaviy uzilishda xulosalar ko'pi bilan shuncha ushlab turiladi (14400 = 4 soat). Uzilish undan uzoq davom etsa,
# kompyuterlar haqiqiy holatiga o'tkaziladi (izohida "ommaviy uzilish davom etmoqda") — dashboard cheksiz "OK" ko'rsatmaydi.
MASS_OUTAGE_MAX_HOLD=14400
# NSEL shuncha soniya kelmasa — "NetFlow kelmayapti" ogohlantirishi, holatlar muzlatiladi.
COLLECTOR_STALE=180
# Bitta FTD'dan shuncha soniya NetFlow kelmasa (va jimlik KESKIN bo'lsa — oldin faol hostlar ko'p edi) —
# "FTD'dan NetFlow kelmayapti" insidenti. Kechqurun filial yopilib, kompyuterlar birin-ketin o'chsa — insident yo'q.
EXPORTER_STALE=600
# Muammo holatiga o'tish uchun ketma-ket tasdiqlar soni (har tekshiruv 1 daqiqada).
DEBOUNCE=2
# Serverlarni ham hisobga olishmi (Windows Server). false = faqat ish stantsiyalari.
INCLUDE_SERVERS=false


# ═══════════════════════════════════════════════════════════════════════════════
# 5. ACTIVE DIRECTORY — kompyuterlar ro'yxati, DC'lar, subnetlar, DNS
#    Kerak: oddiy domen foydalanuvchisi (admin EMAS). Masalan: svc_agentmon
#    AD'siz rejimda: AD_SERVER= va AD_BASE_DN= ni BO'SH qoldiring (qolganlari e'tiborga olinmaydi).
# ═══════════════════════════════════════════════════════════════════════════════

# DC manzili. LDAPS (636, shifrlangan) tavsiya etiladi:  ldaps://dc01.corp.local
#   - DC nomi yoki IP:  ldaps://172.25.10.10
#   - LDAPS yoqilmagan bo'lsa (tavsiya etilmaydi):  ldap://dc01.corp.local
# Tekshirish (serverdan):  nc -zv dc01.corp.local 636
AD_SERVER=ldaps://dc01.corp.local

# Domen "base DN" — domen nomining har bir qismi DC= bilan:
#   corp.local        →  DC=corp,DC=local
#   company.uz        →  DC=company,DC=uz
#   ad.bank.uz        →  DC=ad,DC=bank,DC=uz
# Aniq bilish (DC'da PowerShell):  (Get-ADDomain).DistinguishedName
AD_BASE_DN=DC=corp,DC=local

# Servis hisob. Ikki formatdan biri:
#   svc_agentmon@corp.local      (UPN — tavsiya etiladi)
#   CORP\svc_agentmon            (NetBIOS domen nomi\login)
AD_USER=svc_agentmon@corp.local

# Servis hisob paroli. $ bo'lsa — bitta tirnoqda:  AD_PASSWORD='Qwe$rty123'
AD_PASSWORD='BuYerga-Parol-Yozing'

# DC sertifikatini tekshirish (tavsiya: true). O'chirilsa, tarmoqdagi hujumchi o'zini DC deb ko'rsatib,
# servis hisobi va web'ga kirayotgan xodimlarning AD parollarini ushlab qolishi mumkin (MITM).
# Ichki CA sertifikatini (PEM, Base-64) ./ca/ papkasiga qo'ying va yo'lini yozing:
#   certutil -ca.cert ca.cer  (CA serverida)  →  openssl x509 -inform der -in ca.cer -out ca/corp-ca.pem
AD_VERIFY_TLS=true
AD_CA_FILE=/app/ca/corp-ca.pem

# Domen DNS zonasi (odatda domen nomi bilan bir xil). IP → kompyuter nomi moslash uchun kerak.
# Tekshirish: DNS Manager'da "Forward Lookup Zones" ichidagi zona nomi.
AD_DNS_ZONE=corp.local

# AD'da shuncha kundan beri tizimga kirmagan kompyuter hisoblari "eski" (ro'yxatga qo'shilmaydi).
AD_STALE_DAYS=45


# ═══════════════════════════════════════════════════════════════════════════════
# 6. CORTEX XDR — agentlar ro'yxati va himoya holati
#    Konsol: Settings → Configurations → Integrations → API Keys → "+ New Key"
#      Security Level: Standard,  Role: Viewer (faqat o'qish)
#    Yaratilgandan keyin 3 ta qiymat olinadi (kalit faqat BIR MARTA ko'rsatiladi — saqlab qo'ying!)
# ═══════════════════════════════════════════════════════════════════════════════

# API manzili: API Keys sahifasida "Copy API URL" tugmasi.
# Nusxa:  https://api-mycompany.xdr.eu.paloaltonetworks.com/
# Bu yerga https:// va oxiridagi / SIZ yozing:
CORTEX_FQDN=api-mycompany.xdr.eu.paloaltonetworks.com

# Kalit ID — API Keys jadvalidagi "ID" ustunidagi raqam.
CORTEX_KEY_ID=12

# Kalitning o'zi — yaratishda ko'rsatilgan uzun satr.
CORTEX_KEY=BuYerga-Cortex-API-kalitini-yozing

# Kalit turi: yaratishda "Standard" tanlangan bo'lsa — standard, "Advanced" bo'lsa — advanced.
CORTEX_KEY_TYPE=standard


# ═══════════════════════════════════════════════════════════════════════════════
# 7. KASPERSKY SECURITY CENTER — agent, real-time himoya va bazalar holati
#    KSC'da faqat o'qish huquqli foydalanuvchi yarating (masalan: agentmon_ro).
#    Serverdan KSC'ga 13299 port ochiq bo'lishi kerak:  nc -zv 172.25.25.111 13299
# ═══════════════════════════════════════════════════════════════════════════════

# KSC OpenAPI manzili (siz bergan KSC IP + standart 13299 port).
KSC_URL=https://172.25.25.111:13299

# Foydalanuvchi nomi (domen qismisiz).
KSC_USER=agentmon_ro

# Parol. $ bo'lsa — bitta tirnoqda.
KSC_PASSWORD='BuYerga-KSC-Parol-Yozing'

# Foydalanuvchi turi:
#   KSC'ning ICHKI foydalanuvchisi (KSC konsolida yaratilgan)  →  KSC_INTERNAL_USER=true,  KSC_DOMAIN= (bo'sh)
#   DOMEN hisobi (AD foydalanuvchisi)                           →  KSC_INTERNAL_USER=false, KSC_DOMAIN=CORP
KSC_INTERNAL_USER=true
KSC_DOMAIN=

# KSC sertifikatini tekshirish. KSC o'z-o'zidan imzolangan sertifikat ishlatadi — uni "pin" qilish mumkin:
#   openssl s_client -connect 172.25.25.111:13299 </dev/null 2>/dev/null | openssl x509 > ca/ksc.pem
# va KSC_VERIFY_TLS=true, KSC_CA_FILE=/app/ca/ksc.pem. (Sertifikatdagi nom KSC_URL dagi manzilga mos bo'lishi kerak.)
KSC_VERIFY_TLS=false
KSC_CA_FILE=


# ═══════════════════════════════════════════════════════════════════════════════
# 8. WEB INTERFEYS — kim kira oladi
# ═══════════════════════════════════════════════════════════════════════════════

# Sessiya cookie'larini imzolash kaliti. Kamida 32 belgi. Yaratish:  openssl rand -hex 32
# ⚠ Har bir o'rnatishda O'Z kalitingizni yarating — bu namunani ishlatmang.
WEB_SECRET=

# Kirish usuli:
#   ldap = AD login/parol bilan (quyidagi guruh a'zolari) + favqulodda admin
#   none = parolsiz (FAQAT test uchun, hech qachon real muhitda emas!)
WEB_AUTH=ldap

# Interfeysga kira oladigan AD guruhining to'liq DN'i (ichma-ich guruhlar ham hisoblanadi).
# AD'da guruh yarating (masalan AgentMon-Users), xodimlarni qo'shing, DN'ni oling:
#   PowerShell:  (Get-ADGroup AgentMon-Users).DistinguishedName
# Bo'sh qoldirilsa — domendagi HAR QANDAY foydalanuvchi kira oladi (tavsiya etilmaydi).
WEB_ALLOWED_GROUP=CN=AgentMon-Users,OU=Groups,DC=corp,DC=local

# O'zgartirish huquqi (hostni istisno qilish, IP'ni "ma'lum qurilma" deb yashirish) — faqat shu guruh a'zolarida.
# Qolganlar faqat ko'radi. Barcha o'zgarishlar "Tizim holati → Audit jurnali"da yoziladi.
# Bo'sh qoldirilsa — WEB_ALLOWED_GROUP'dagi HAMMA o'zgartira oladi (tavsiya etilmaydi: xodim o'z qurilmasini yashirishi mumkin).
#   PowerShell:  (Get-ADGroup AgentMon-Admins).DistinguishedName
WEB_ADMIN_GROUP=CN=AgentMon-Admins,OU=Groups,DC=corp,DC=local

# Favqulodda lokal admin (AD ishlamay qolganda kirish uchun). Parol ochiq yozilmaydi — faqat hash:
#   docker compose run --rm api python -m agentmon.api.auth hash
#   (parolni so'raydi, chiqqan  pbkdf2_sha256:...  satrini quyiga qo'ying)
# Kerak bo'lmasa — ikkalasini ham bo'sh qoldiring.
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD_HASH=

# Sessiya cookie'si faqat HTTPS orqali yuboriladi. Interfeys HTTPS'da ishlaydi — o'zgartirmang.
WEB_COOKIE_SECURE=true
